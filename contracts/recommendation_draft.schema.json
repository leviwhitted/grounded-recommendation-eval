{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leviwhitted/clixsy-oracle-agent/blob/main/contracts/recommendation_draft.schema.json",
  "title": "Oracle Recommendation Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_id",
    "subject",
    "title",
    "summary",
    "recommendation_type",
    "supporting_evidence_bundle_ids",
    "rationale",
    "confidence",
    "priority",
    "unknowns"
  ],
  "properties": {
    "draft_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "recommendation_type": {
      "type": "string",
      "enum": [
        "investigate",
        "implement",
        "monitor",
        "defer"
      ]
    },
    "supporting_evidence_bundle_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "urgency",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "urgency": {
          "type": "string",
          "enum": [
            "immediate",
            "soon",
            "later"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggested_next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
