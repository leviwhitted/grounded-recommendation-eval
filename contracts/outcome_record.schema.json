{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leviwhitted/clixsy-oracle-agent/blob/main/contracts/outcome_record.schema.json",
  "title": "Oracle Outcome Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome_record_id",
    "project_id",
    "created_at",
    "subject",
    "related_recommendation_ids",
    "status",
    "observed_result",
    "confidence",
    "unknowns"
  ],
  "properties": {
    "outcome_record_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "related_recommendation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_evidence_bundle_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked",
        "inconclusive"
      ]
    },
    "observed_result": {
      "type": "string",
      "minLength": 1
    },
    "impact_summary": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
