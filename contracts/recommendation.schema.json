{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leviwhitted/clixsy-oracle-agent/blob/main/contracts/recommendation.schema.json",
  "title": "Oracle Recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_id",
    "project_id",
    "created_at",
    "subject",
    "title",
    "summary",
    "recommendation_type",
    "supporting_evidence_bundle_ids",
    "rationale",
    "confidence",
    "priority",
    "unknowns"
  ],
  "properties": {
    "recommendation_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "recommendation_type": {
      "type": "string",
      "enum": [
        "investigate",
        "implement",
        "monitor",
        "defer"
      ]
    },
    "supporting_evidence_bundle_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "urgency",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "urgency": {
          "type": "string",
          "enum": [
            "immediate",
            "soon",
            "later"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kb_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atom_id",
          "atom_title",
          "relevance_note"
        ],
        "properties": {
          "atom_id": {
            "type": "string",
            "minLength": 1
          },
          "atom_title": {
            "type": "string",
            "minLength": 1
          },
          "relevance_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_finding_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "relevance_note"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "relevance_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_to_atom_trace": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggested_next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
