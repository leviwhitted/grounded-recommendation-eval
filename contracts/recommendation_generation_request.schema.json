{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leviwhitted/clixsy-oracle-agent/blob/main/contracts/recommendation_generation_request.schema.json",
  "title": "Oracle Recommendation Generation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "project_id",
    "created_at",
    "subject",
    "evidence_bundle_ids"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "evidence_bundle_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "request_scope": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
